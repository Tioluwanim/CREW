DATABASE_URL=sqlite:///./crew.db
JWT_SECRET=dev-only-change-me-please-rotate-32
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
CREW_DEMO_MODE=true            # enables POST /api/auth/demo (seeded Amara Studio workspace)
PAYMENT_PROVIDER=sandbox       # sandbox | ecobank (ecobank is a skeleton until credentials + API docs exist)
WEBHOOK_SECRET=change-me
ECOBANK_BASE_URL=
ECOBANK_CLIENT_ID=
ECOBANK_CLIENT_SECRET=
ECOBANK_WEBHOOK_SECRET=
VERVE_BASE_URL=
VERVE_CLIENT_ID=
VERVE_CLIENT_SECRET=
VERVE_WEBHOOK_SECRET=
FORECASTER=baseline            # swap when a learned forecaster is registered
AGENT_RUNTIME=null             # swap when the real agent is registered
CREW_ENV=development           # production refuses to boot with dev secrets, SQLite or demo flags
DEMO_AUTO_AUTH=false           # dev-only: requests with no Authorization header act as the demo user
AUTO_CREATE_TABLES=true        # set false in production and run `alembic upgrade head`
DL_ARTIFACT_DIR=./artifacts
CRON_SECRET=                   # set to enable POST /api/system/sweep (header X-Cron-Secret)
SMTP_HOST=                     # empty = console fallback: messages are marked `logged`, never `sent`
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ---- payments (provider-agnostic; see docs/PAYMENT_ADAPTERS.md)
PAYOUT_PROVIDER=               # empty = same as PAYMENT_PROVIDER; set to pay creators through a different rail
SANDBOX_ASYNC_PAYOUTS=false    # true = sandbox payouts start PENDING and finish via webhook, like real rails
