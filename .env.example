# CREW frontend — environment variables

# Section 43b mock-to-real swap: set to "false" to point every service
# function (src/services/*) at a real backend instead of the MSW mock.
# Defaults to mock-on (true) — the app runs with no env vars set at all.
VITE_USE_MOCK_API=true

# Base URL for the FastAPI backend. Only read when VITE_USE_MOCK_API=false.
VITE_API_BASE_URL=

# Public key for a future payment provider integration (not wired yet)
VITE_PAYMENTS_PUBLIC_KEY=
