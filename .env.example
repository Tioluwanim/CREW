# CREW frontend — environment variables

# Section 43b mock-to-real swap: set to "false" to point every service
# function (src/services/*) at a real backend instead of the MSW mock.
# Defaults to mock-on (true) — the app runs with no env vars set at all.
# Leave unset to auto-detect: live when NEXT_PUBLIC_API_BASE_URL is set, otherwise the built-in demo.
# These are inlined at BUILD time: after changing them, rebuild/redeploy.
NEXT_PUBLIC_USE_MOCK_API=

# Base URL for the FastAPI backend. Only read when NEXT_PUBLIC_USE_MOCK_API=false.
NEXT_PUBLIC_API_BASE_URL=

# Public key for a future payment provider integration (not wired yet)
NEXT_PUBLIC_PAYMENTS_PUBLIC_KEY=

# Live-backend only (NEXT_PUBLIC_USE_MOCK_API=false). Dev convenience: fetch a demo
# token from POST /auth/demo on first request, so the app works before a login
# screen exists. Needs the backend to run with CREW_DEMO_MODE=true and seeded data.
# Leave unset/false in production; sign in with src/services/auth.ts login() instead.
NEXT_PUBLIC_DEMO_AUTO_LOGIN=false
